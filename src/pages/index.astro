---
import BaseLayout from '../layouts/BaseLayout/index.astro';
import Card from '../components/foundation/Card/index.astro';
import Button from '../components/foundation/Button/index.astro';
import Callout from '../components/foundation/Callout/index.astro';
import styles from './styles.module.css';

const evidenceTopics = [
  {
    title: 'Fine-Tuned Universe',
    description: 'The universe exhibits extraordinary precision in its fundamental constants. Evidence of intelligent design.',
    href: '/evidence/fine-tuned-universe',
    icon: '🌌'
  },
  {
    title: 'Big Bang Theory',
    description: 'Science confirms the universe had a beginning. This aligns with Genesis and points to a Creator.',
    href: '/evidence/big-bang',
    icon: '💥'
  },
  {
    title: 'DNA & Design',
    description: 'The information in DNA points to an intelligent designer. The math is staggering.',
    href: '/evidence/dna',
    icon: '🧬'
  },
  {
    title: 'Manuscript Evidence',
    description: '25,000+ manuscripts prove the New Testament has been faithfully preserved over centuries.',
    href: '/evidence/manuscript-evidence',
    icon: '📜'
  },
  {
    title: 'Dead Sea Scrolls',
    description: 'Ancient scrolls confirm the accuracy of Old Testament transmission over 1,000 years.',
    href: '/evidence/dead-sea-scrolls',
    icon: '📖'
  },
  {
    title: 'Prophetic Probability',
    description: '300+ prophecies about the Messiah, fulfilled in Jesus. The math is impossible by chance.',
    href: '/evidence/prophetic-probability',
    icon: '✡️'
  }
];

const journeySteps = [
  {
    title: 'Atheism',
    description: 'The starting point for many. "There is no God" requires more faith than belief.'
  },
  {
    title: 'Agnosticism',
    description: 'Recognizing uncertainty. The doorway to inquiry begins to open.'
  },
  {
    title: 'Seeking',
    description: 'Curiosity emerges. Beginning to question previous assumptions about faith.'
  },
  {
    title: 'Investigation',
    description: 'Actively exploring evidence, history, and the claims of Christianity.'
  },
  {
    title: 'Faith',
    description: 'Coming to believe. Trust in God through Christ and His Church.'
  },
  {
    title: 'The Church',
    description: 'Finding community, truth, and the sacraments. The journey continues in fellowship.'
  }
];
---

<BaseLayout title="Home" currentPath="/">
  <section class={styles.hero}>
    <div class={styles.heroInner}>
      <h1>The Open Apologetic</h1>
      <p class={styles.subheader}>"It takes more faith not to believe than it does to believe"</p>
      <p class={styles.intro}>
        Building a cumulative case for Catholic Christianity through scientific, historical, and spiritual evidence. 
        Not to "prove" God in a mathematical sense, but to show that multiple independent lines of evidence 
        point strongly toward the truth of our faith.
      </p>
    </div>
  </section>
  
  <section class={styles.section}>
    <div class={styles.sectionInner}>
      <h2 class={styles.sectionTitle}>Scientific & Historical Evidence</h2>
      <div class={styles.grid}>
        {evidenceTopics.map((topic) => (
          <Card href={topic.href} variant="evidence" icon={topic.icon}>
            <span slot="title">{topic.title}</span>
            {topic.description}
          </Card>
        ))}
      </div>
    </div>
  </section>
  
  <section class={`${styles.section} ${styles.journey}`}>
    <div class={styles.sectionInner}>
      <h2 class={styles.sectionTitle}>The Faith Journey</h2>
      <p style="text-align: center; max-width: 600px; margin: 0 auto var(--space-8); color: var(--text-secondary);">
        Many Catholics have walked a path from skepticism to faith. Here's a common journey:
      </p>
      <div class={styles.journeySteps}>
        {journeySteps.map((step, index) => (
          <div class={styles.journeyStep}>
            <div class={styles.stepNumber}>{index + 1}</div>
            <div class={styles.stepContent}>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <div class="container" style="max-width: var(--max-prose-width); margin: 0 auto; padding: 0 var(--space-4);">
    <Callout type="quote" title="Why Evidence Matters">
      <p>"We are called to always be ready to give an explanation to anyone who asks you for a reason for your hope."</p>
      <span class={styles.attribution}>— 1 Peter 3:15</span>
    </Callout>
  </div>
  
  <section class={styles.cta}>
    <div class={styles.sectionInner}>
      <h2>Begin Your Exploration</h2>
      <p>
        Dive into the evidence. Each topic builds on others to create a cumulative case 
        for the truth of Catholic Christianity.
      </p>
      <Button href="/evidence" variant="gold" size="large">
        View All Evidence →
      </Button>
    </div>
  </section>
</BaseLayout>
