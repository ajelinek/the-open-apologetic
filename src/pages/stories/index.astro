---
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import CategoryFilter from '../../components/layout/CategoryFilter/index.astro';
import Card from '../../components/foundation/Card/index.astro';
import { baseUrl, routes } from '../../config/site';
import { STORIES_CATEGORIES } from '../../config/categories';

const categoryInfo = {
  title: 'Stories of Faith',
  description: 'Real stories from real people. Browse testimonies and miracles or share your own experience of God working in your life.'
};

const storiesItems = [
  {
    id: 'testimonies',
    title: 'Testimonies',
    description: 'Personal stories of faith, conversion, and spiritual growth. Read how others have encountered God in their lives.',
    href: routes.testimonies(),
    icon: '📣'
  },
  {
    id: 'miracles',
    title: 'Miracles',
    description: 'Share and read about supernatural occurrences, answered prayers, and encounters with the divine.',
    href: routes.miracles(),
    icon: '✨'
  }
];
---

<BaseLayout title="Stories" currentPath="/stories">
  <div class="stories-layout">
    <CategoryFilter 
      categories={STORIES_CATEGORIES}
      currentPath="/stories"
      baseUrl={baseUrl}
      section="stories"
    />
    
    <main class="stories-main">
      <div class="stories-inner">
        <div class="stories-header">
          <h1>{categoryInfo.title}</h1>
          <p>{categoryInfo.description}</p>
        </div>
        
        <div class="grid">
          {storiesItems.map((item) => (
            <Card href={item.href} icon={item.icon}>
              <span slot="title">{item.title}</span>
              {item.description}
            </Card>
          ))}
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .stories-layout {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    gap: var(--space-8);
  }

  .stories-main {
    flex: 1;
    min-width: 0;
  }

  .stories-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .stories-header {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .stories-header h1 {
    margin-bottom: var(--space-4);
  }

  .stories-header p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 37.5rem;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 767px) {
    .stories-layout {
      flex-direction: column;
    }
  }
</style>
