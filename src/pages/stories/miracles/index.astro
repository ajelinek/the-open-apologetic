---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import CategoryFilter from '../../../components/layout/CategoryFilter/index.astro';
import Button from '../../../components/foundation/Button/index.astro';
import { baseUrl, routes, siteConfig } from '../../../config/site';

const storiesCategories = [
  { id: 'testimonies', label: 'Testimonies' },
  { id: 'miracles', label: 'Miracles' }
];

const categoryInfo = {
  title: 'Miracle Stories',
  description: 'Supernatural occurrences, answered prayers, and encounters with the divine. Read about the miraculous ways God is working in people\'s lives.'
};

const contributeLink = `${siteConfig.github}/issues/new?title=My Miracle: &body=Share your miracle story here...`;
---

<BaseLayout title="Miracles" currentPath="/stories/miracles">
  <div class="stories-layout">
    <CategoryFilter 
      categories={storiesCategories}
      activeCategory="miracles"
      currentPath="/stories/miracles"
      baseUrl={baseUrl}
      section="stories"
    />
    
    <main class="stories-main">
      <div class="stories-inner">
        <div class="stories-header">
          <h1>{categoryInfo.title}</h1>
          <p>{categoryInfo.description}</p>
        </div>
        
        <div class="coming-soon">
          <div class="coming-soon-icon">✨</div>
          <h2>Coming Soon</h2>
          <p>
            We're gathering miracle stories from across the Catholic community—large and small, 
            every miracle testifies to God's love and power.
          </p>
          <p>
            Have you witnessed or experienced a miracle? We'd love to hear about it.
          </p>
          
          <div class="contribute-box">
            <h3>How to Contribute</h3>
            <p>
              To share a miracle story, please create a GitHub issue. 
              Our team will review your submission and may feature it on this page.
            </p>
            <Button href={contributeLink} variant="gold" target="_blank" rel="noopener noreferrer">
              Share Your Miracle →
            </Button>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .stories-layout {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    gap: var(--space-8);
  }

  .stories-main {
    flex: 1;
    min-width: 0;
  }

  .stories-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .stories-header {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .stories-header h1 {
    margin-bottom: var(--space-4);
  }

  .stories-header p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 37.5rem;
    margin: 0 auto;
  }

  .coming-soon {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background-color: var(--color-cream);
    border-radius: var(--radius-lg);
  }

  .coming-soon-icon {
    font-size: 4rem;
    margin-bottom: var(--space-4);
  }

  .coming-soon h2 {
    margin-bottom: var(--space-4);
    color: var(--color-burgundy);
  }

  .coming-soon p {
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    max-width: 31.25rem;
    margin-left: auto;
    margin-right: auto;
  }

  .contribute-box {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: 2px solid var(--color-gold);
  }

  .contribute-box h3 {
    margin-bottom: var(--space-3);
    color: var(--color-burgundy);
  }

  .contribute-box p {
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 767px) {
    .stories-layout {
      flex-direction: column;
    }
  }
</style>
