---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import CategoryFilter from '../../../components/layout/CategoryFilter/index.astro';
import Button from '../../../components/foundation/Button/index.astro';
import { baseUrl, routes, siteConfig } from '../../../config/site';
import { STORIES_CATEGORIES } from '../../../config/categories';

const categoryInfo = {
  title: 'Testimonies',
  description: 'Personal stories of faith, conversion, and spiritual growth. Read how others have encountered God in their lives.'
};

const contributeLink = `${siteConfig.github}/issues/new?title=My Testimony: &body=Share your testimony story here...`;
---

<BaseLayout title="Testimonies" currentPath="/stories/testimonies">
  <div class="stories-layout">
    <CategoryFilter 
      categories={STORIES_CATEGORIES}
      activeCategory="testimonies"
      currentPath="/stories/testimonies"
      baseUrl={baseUrl}
      section="stories"
    />
    
    <main class="stories-main">
      <div class="stories-inner">
        <div class="stories-header">
          <h1>{categoryInfo.title}</h1>
          <p>{categoryInfo.description}</p>
        </div>
        
        <div class="coming-soon">
          <div class="coming-soon-icon">📣</div>
          <h2>Coming Soon</h2>
          <p>
            We're building a collection of powerful testimonies from people who have experienced 
            God's love and grace in their lives.
          </p>
          <p>
            Have a testimony to share? We want to hear your story!
          </p>
          
          <div class="contribute-box">
            <h3>How to Contribute</h3>
            <p>
              To add your testimony to this collection, please create a GitHub issue. 
              Our team will review your submission and may feature it on this page.
            </p>
            <Button href={contributeLink} variant="gold" target="_blank" rel="noopener noreferrer">
              Share Your Testimony →
            </Button>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .stories-layout {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    gap: var(--space-8);
  }

  .stories-main {
    flex: 1;
    min-width: 0;
  }

  .stories-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .stories-header {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .stories-header h1 {
    margin-bottom: var(--space-4);
  }

  .stories-header p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 37.5rem;
    margin: 0 auto;
  }

  .coming-soon {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background-color: var(--color-cream);
    border-radius: var(--radius-lg);
  }

  .coming-soon-icon {
    font-size: 4rem;
    margin-bottom: var(--space-4);
  }

  .coming-soon h2 {
    margin-bottom: var(--space-4);
    color: var(--color-burgundy);
  }

  .coming-soon p {
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    max-width: 31.25rem;
    margin-left: auto;
    margin-right: auto;
  }

  .contribute-box {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: 2px solid var(--color-gold);
  }

  .contribute-box h3 {
    margin-bottom: var(--space-3);
    color: var(--color-burgundy);
  }

  .contribute-box p {
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 767px) {
    .stories-layout {
      flex-direction: column;
    }
  }
</style>
