---
import { getCollection, type CollectionEntry } from 'astro:content';
import { sortByOrder, filterAndSortByCategory } from '../../utils/sorting';
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import Card from '../../components/foundation/Card/index.astro';
import CategoryFilter from '../../components/layout/CategoryFilter/index.astro';
import { baseUrl, routes } from '../../config/site';
import { EVIDENCE_CATEGORIES, EVIDENCE_DESCRIPTIONS } from '../../config/categories';
import styles from './styles.module.css';
import categoryStyles from './category.module.css';

const allEvidence = await getCollection('evidence');

const grouped: Record<string, CollectionEntry<'evidence'>[]> = {
  scientific: filterAndSortByCategory(allEvidence, 'scientific'),
  historical: filterAndSortByCategory(allEvidence, 'historical'),
  biblical: filterAndSortByCategory(allEvidence, 'biblical'),
  philosophy: filterAndSortByCategory(allEvidence, 'philosophy'),
  doctrine: filterAndSortByCategory(allEvidence, 'doctrine'),
};

const allArticles = [
  ...grouped.scientific,
  ...grouped.historical,
  ...grouped.biblical,
  ...grouped.philosophy,
  ...grouped.doctrine,
];

const categoryLabels: Record<string, string> = Object.fromEntries(
  EVIDENCE_CATEGORIES.map(cat => [cat.id, cat.label])
);
---

<BaseLayout title="Evidence" currentPath="/evidence">
  <div class={categoryStyles.layout}>
    <CategoryFilter 
      categories={EVIDENCE_CATEGORIES}
      articles={allArticles.map(entry => ({ slug: entry.slug, title: entry.data.title }))}
      currentPath="/evidence"
      baseUrl={baseUrl}
      section="evidence"
    />
    
    <main class={categoryStyles.main}>
      <div class={styles.pageInner}>
        <div class={styles.header}>
          <h1>Evidence for the Faith</h1>
          <p>
            Explore multiple independent lines of evidence that together build a cumulative case 
            for Catholic Christianity.
          </p>
        </div>
        
        {Object.entries(grouped).map(([category, items]) => (
          items.length > 0 && (
            <div class={styles.category}>
              <h2 class={styles.categoryTitle}>{categoryLabels[category]}</h2>
              <div class={styles.grid}>
                {items.map((entry: CollectionEntry<'evidence'>) => (
                  <Card href={`${baseUrl}/evidence/${entry.slug}`} icon={entry.data.icon}>
                    <span slot="title">{entry.data.title}</span>
                    {entry.data.description}
                  </Card>
                ))}
              </div>
            </div>
          )
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
