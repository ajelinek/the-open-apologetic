---
import { getCollection, type CollectionEntry } from 'astro:content';
import { sortByOrder, filterAndSortByCategory } from '../../utils/sorting';
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import Card from '../../components/foundation/Card/index.astro';
import styles from './styles.module.css';
import categoryStyles from './category.module.css';

const baseUrl = '/the-open-apologetic';

const allEvidence = await getCollection('evidence');

const allCategories = ['scientific', 'historical', 'biblical', 'philosophy', 'doctrine'];
const categoryLabels: Record<string, string> = {
  scientific: 'Scientific Evidence',
  historical: 'Historical Evidence',
  biblical: 'Biblical Evidence',
  philosophy: 'Philosophy & Apologetics',
  doctrine: 'Catholic Doctrine'
};

const categoryDescriptions: Record<string, string> = {
  scientific: 'Evidence from science that points toward the existence of God and the design of the universe.',
  historical: 'Historical facts and archaeological discoveries that support the credibility of the Bible and Christianity.',
  biblical: 'Internal biblical evidence including manuscript accuracy, prophecies, and textual analysis.',
  philosophy: 'Philosophical arguments for God\'s existence and responses to common objections against faith.',
  doctrine: 'Supernatural occurrences and teachings that attest to the truth of Catholic doctrine and the intercession of saints.'
};

const grouped: Record<string, CollectionEntry<'evidence'>[]> = {
  scientific: filterAndSortByCategory(allEvidence, 'scientific'),
  historical: filterAndSortByCategory(allEvidence, 'historical'),
  biblical: filterAndSortByCategory(allEvidence, 'biblical'),
  philosophy: filterAndSortByCategory(allEvidence, 'philosophy'),
  doctrine: filterAndSortByCategory(allEvidence, 'doctrine'),
};

const allArticles = [
  ...grouped.scientific,
  ...grouped.historical,
  ...grouped.biblical,
  ...grouped.philosophy,
  ...grouped.doctrine,
];
---

<BaseLayout title="Evidence" currentPath="/evidence">
  <div class={categoryStyles.layout}>
    <aside class={categoryStyles.sidebar}>
      <nav class={categoryStyles.sideNav}>
        <h3 class={categoryStyles.sideNavTitle}>Categories</h3>
        <ul class={categoryStyles.sideNavList}>
          {allCategories.map((cat) => (
            <li>
              <a 
                href={`${baseUrl}/evidence/${cat}`} 
                class:list={[
                  categoryStyles.sideNavLink,
                ]}
              >
                {categoryLabels[cat]}
              </a>
            </li>
          ))}
        </ul>
        
        <h3 class={categoryStyles.sideNavTitle}>All Articles</h3>
        <ul class={categoryStyles.articleList}>
          {allArticles.map((entry) => (
            <li>
              <a 
                href={`${baseUrl}/evidence/${entry.slug}`} 
                class={categoryStyles.articleLink}
              >
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
    
    <main class={categoryStyles.main}>
      <div class={styles.pageInner}>
        <div class={styles.header}>
          <h1>Evidence for the Faith</h1>
          <p>
            Explore multiple independent lines of evidence that together build a cumulative case 
            for Catholic Christianity.
          </p>
        </div>
        
        {Object.entries(grouped).map(([category, items]) => (
          items.length > 0 && (
            <div class={styles.category}>
              <h2 class={styles.categoryTitle}>{categoryLabels[category]}</h2>
              <div class={styles.grid}>
                {items.map((entry: CollectionEntry<'evidence'>) => (
                  <Card href={`${baseUrl}/evidence/${entry.slug}`} icon={entry.data.icon}>
                    <span slot="title">{entry.data.title}</span>
                    {entry.data.description}
                  </Card>
                ))}
              </div>
            </div>
          )
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
