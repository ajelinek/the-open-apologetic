---
import { getCollection, type CollectionEntry } from 'astro:content';
import { filterAndSortByCategory } from '../../../utils/sorting';
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import CategoryLayout from '../../../components/layout/CategoryLayout/index.astro';
import Card from '../../../components/foundation/Card/index.astro';
import { baseUrl, routes } from '../../../config/site';

export async function getStaticPaths() {
  const categories = ['scientific', 'historical', 'biblical', 'philosophy', 'doctrine'];
  
  const categoryInfo: Record<string, { title: string; description: string }> = {
    scientific: {
      title: 'Scientific Evidence',
      description: 'Evidence from science that points toward the existence of God and the design of the universe.'
    },
    historical: {
      title: 'Historical Evidence',
      description: 'Historical facts and archaeological discoveries that support the credibility of the Bible and Christianity.'
    },
    biblical: {
      title: 'Biblical Evidence',
      description: 'Internal biblical evidence including manuscript accuracy, prophecies, and textual analysis.'
    },
    philosophy: {
      title: 'Philosophy & Apologetics',
      description: 'Philosophical arguments for God\'s existence and responses to common objections against faith.'
    },
    doctrine: {
      title: 'Catholic Doctrine',
      description: 'Supernatural occurrences and teachings that attest to the truth of Catholic doctrine and the intercession of saints.'
    }
  };

  return categories.map((category) => ({
    params: { category },
    props: { categoryInfo: categoryInfo[category], category }
  }));
}

interface Props {
  categoryInfo: { title: string; description: string };
  category: string;
}

const { categoryInfo, category } = Astro.props;
const allEvidence = await getCollection('evidence');
const categoryEvidence = filterAndSortByCategory(allEvidence, category);

const evidenceCategories = [
  { id: 'scientific', label: 'Scientific Evidence' },
  { id: 'historical', label: 'Historical Evidence' },
  { id: 'biblical', label: 'Biblical Evidence' },
  { id: 'philosophy', label: 'Philosophy & Apologetics' },
  { id: 'doctrine', label: 'Catholic Doctrine' }
];
---

<BaseLayout title={categoryInfo.title} currentPath={`/evidence/${category}`}>
  <CategoryLayout 
    categories={evidenceCategories}
    activeCategory={category}
    currentPath={`/evidence/${category}`}
    title={categoryInfo.title}
    description={categoryInfo.description}
    baseUrl={baseUrl}
    section="evidence"
  >
    <div class="articles-list">
      {categoryEvidence.map((entry: CollectionEntry<'evidence'>) => (
        <Card href={`${baseUrl}/evidence/${entry.slug.replace(/\d+_/g, '').split('/').pop() || ''}`} icon={entry.data.icon}>
          <span slot="title">{entry.data.title}</span>
          {entry.data.description}
        </Card>
      ))}
    </div>
  </CategoryLayout>
</BaseLayout>

<style>
  .articles-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }
</style>
