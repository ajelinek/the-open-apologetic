---
import { getCollection, type CollectionEntry } from 'astro:content';
import { filterAndSortByCategory } from '../../../utils/sorting';
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import CategoryFilter from '../../../components/layout/CategoryFilter/index.astro';
import Card from '../../../components/foundation/Card/index.astro';
import { baseUrl, routes } from '../../../config/site';
import { EVIDENCE_CATEGORIES, EVIDENCE_DESCRIPTIONS } from '../../../config/categories';

export async function getStaticPaths() {
  return EVIDENCE_CATEGORIES.map((category) => ({
    params: { category: category.id },
    props: { 
      categoryInfo: {
        title: category.label,
        description: EVIDENCE_DESCRIPTIONS[category.id]
      },
      category: category.id
    }
  }));
}

interface Props {
  categoryInfo: { title: string; description: string };
  category: string;
}

const { categoryInfo, category } = Astro.props;
const allEvidence = await getCollection('evidence');
const categoryEvidence = filterAndSortByCategory(allEvidence, category);
---

<BaseLayout title={categoryInfo.title} currentPath={`/evidence/${category}`}>
  <div class="category-layout">
    <CategoryFilter 
      categories={EVIDENCE_CATEGORIES}
      activeCategory={category}
      currentPath={`/evidence/${category}`}
      baseUrl={baseUrl}
      section="evidence"
    />
    
    <main class="category-main">
      <div class="category-inner">
        <div class="category-header">
          <h1>{categoryInfo.title}</h1>
          <p>{categoryInfo.description}</p>
        </div>
        
         <div class="articles-list">
           {categoryEvidence.map((entry: CollectionEntry<'evidence'>) => (
             <Card href={`${baseUrl}/evidence/${entry.slug}`} icon={entry.data.icon} slug={entry.slug}>
               <span slot="title">{entry.data.title}</span>
               {entry.data.description}
             </Card>
           ))}
         </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .category-layout {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    gap: var(--space-8);
  }

  .category-main {
    flex: 1;
    min-width: 0;
  }

  .category-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .category-header {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .category-header h1 {
    margin-bottom: var(--space-4);
  }

  .category-header p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 37.5rem;
    margin: 0 auto;
  }

  .articles-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 767px) {
    .category-layout {
      flex-direction: column;
    }
  }
</style>
