---
import styles from './styles.module.css';

interface Props {
  type?: 'info' | 'quote' | 'warning';
  title?: string;
  icon?: string;
}

const {
  type = 'info',
  title,
  icon
} = Astro.props;

const defaultIcons = {
  info: 'ℹ️',
  quote: '💬',
  warning: '⚠️'
};

const displayIcon = icon || defaultIcons[type];
---

<aside class:list={[styles.callout, styles[type]]}>
  {(title || type !== 'info') && (
    <div class={styles.calloutTitle}>
      {displayIcon} {title || (type === 'quote' ? 'Quote' : type === 'warning' ? 'Note' : 'Info')}
    </div>
  )}
  <div class={styles.calloutContent}>
    <slot />
  </div>
</aside>
