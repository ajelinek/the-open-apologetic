---
import styles from './styles.module.css';

interface Props {
  href?: string;
  icon?: string;
  slug?: string;
  class?: string;
}

const {
  href,
  icon,
  slug,
  class: className
} = Astro.props;

const classList = [
  styles.card,
  href && styles.interactive,
  className
].filter(Boolean);
---

{href ? (
  <a href={href} class:list={classList} data-slug={slug}>
    {icon && <div class={styles.icon}>{icon}</div>}
    <div class={styles.header}>
      <h3 class={styles.title}><slot name="title" /></h3>
    </div>
    <p class={styles.description}><slot /></p>
    <span class={styles.link}>
      Learn more
      <span class={styles.linkArrow}>→</span>
    </span>
    {slug && <div class={styles.badge} aria-label="Read" data-testid="read-badge">✓</div>}
  </a>
) : (
  <div class:list={classList} data-slug={slug}>
    {icon && <div class={styles.icon}>{icon}</div>}
    <div class={styles.header}>
      <h3 class={styles.title}><slot name="title" /></h3>
    </div>
    <p class={styles.description}><slot /></p>
    {slug && <div class={styles.badge} aria-label="Read" data-testid="read-badge">✓</div>}
  </div>
)}
