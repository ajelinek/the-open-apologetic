---
import styles from './styles.module.css';

interface Props {
  href?: string;
  variant?: 'default' | 'evidence';
  icon?: string;
  class?: string;
}

const {
  href,
  variant = 'default',
  icon,
  class: className
} = Astro.props;

const classList = [
  styles.card,
  variant === 'evidence' && styles.evidence,
  href && styles.interactive,
  className
].filter(Boolean);
---

{href ? (
  <a href={href} class:list={classList}>
    {icon && <div class={styles.icon}>{icon}</div>}
    <div class={styles.header}>
      <h3 class={styles.title}><slot name="title" /></h3>
    </div>
    <p class={styles.description}><slot /></p>
    <span class={styles.link}>
      Learn more
      <span class={styles.linkArrow}>→</span>
    </span>
  </a>
) : (
  <div class:list={classList}>
    {icon && <div class={styles.icon}>{icon}</div>}
    <div class={styles.header}>
      <h3 class={styles.title}><slot name="title" /></h3>
    </div>
    <p class={styles.description}><slot /></p>
  </div>
)}
