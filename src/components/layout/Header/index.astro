---
import styles from './styles.module.css';
import Icon from '../../foundation/Icon/index.astro';
import { siteConfig } from '../../../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isStoriesActive = currentPath.startsWith('/stories');

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/evidence', label: 'Evidence' },
  { href: '/stories', label: 'Stories', hasDropdown: true },
];

const storiesSubNav = [
  { href: '/stories/testimonies', label: 'Testimonies' },
  { href: '/stories/miracles', label: 'Miracles' },
];
---

<header class={styles.header}>
  <div class={styles.headerInner}>
    <a href="/" class={styles.logo}>
      <span class={styles.logoIcon}>✝</span>
      <span>The Open Apologetic</span>
    </a>
    
    <nav class={styles.nav}>
      {navLinks.map((link) => (
        link.hasDropdown ? (
          <div class={styles.dropdown}>
            <a 
              href={link.href} 
              class:list={[
                styles.navLink, 
                { 
                  active: currentPath === link.href || isStoriesActive 
                }
              ]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {link.label}
              <span class={styles.dropdownArrow}>▼</span>
            </a>
            <div class={styles.dropdownMenu}>
              {storiesSubNav.map((subLink) => (
                <a 
                  href={subLink.href} 
                  class:list={[
                    styles.dropdownLink,
                    { active: currentPath === subLink.href }
                  ]}
                >
                  {subLink.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a 
            href={link.href} 
            class:list={[styles.navLink, { active: currentPath === link.href }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        )
      ))}
      <a 
        href={siteConfig.github} 
        class={styles.navLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View on GitHub"
      >
        <Icon name="github" size={18} />
      </a>
    </nav>
  </div>
</header>
