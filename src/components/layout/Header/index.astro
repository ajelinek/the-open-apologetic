---
import styles from './styles.module.css';
import Icon from '../../foundation/Icon/index.astro';
import { baseUrl, routes, siteConfig } from '../../../config/site';
import { navLinks } from '../../../config/navData';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isActive = (href: string) => {
  const path = href.replace(baseUrl, '');
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---

<header class={styles.header}>
  <div class={styles.headerInner}>
    <a href={baseUrl + '/'} class={styles.logo}>
      <span class={styles.logoIcon}>✝</span>
      <span class={styles.logoText}>The Open Apologetic</span>
    </a>
    
    <button 
      class={styles.menuToggle} 
      aria-label="Toggle navigation menu" 
      aria-expanded="false"
      id="menu-toggle"
      type="button"
    >
      <span class={styles.hamburger}>
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
    
    <nav class={styles.nav} id="main-nav">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class:list={[styles.navLink, { active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a 
        href={siteConfig.github} 
        class={styles.navLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View on GitHub"
      >
        <Icon name="github" size={18} />
      </a>
    </nav>
  </div>
</header>

<div class={styles.backdrop} id="menu-backdrop"></div>

<script is:inline>
  console.log('Header script loading...');
  
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  const backdrop = document.getElementById('menu-backdrop');
  
  console.log('Elements found:', { toggle: !!toggle, nav: !!nav, backdrop: !!backdrop });
  
  function openMenu() {
    nav.style.transform = 'translateX(0)';
    backdrop.style.opacity = '1';
    backdrop.style.visibility = 'visible';
    document.body.style.overflow = 'hidden';
    toggle.setAttribute('aria-expanded', 'true');
  }
  
  function closeMenu() {
    nav.style.transform = '';
    backdrop.style.opacity = '';
    backdrop.style.visibility = '';
    document.body.style.overflow = '';
    toggle.setAttribute('aria-expanded', 'false');
  }
  
  if (toggle && nav && backdrop) {
    toggle.addEventListener('click', function() {
      console.log('Toggle clicked!');
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
      console.log('Menu opened:', !isOpen);
    });
    
    backdrop.addEventListener('click', function() {
      closeMenu();
    });
    
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });
    
    console.log('Event listeners attached');
  } else {
    console.log('Some elements missing!');
  }
</script>
