---
import styles from './styles.module.css';
import Icon from '../../foundation/Icon/index.astro';
import { siteConfig } from '../../../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const baseUrl = '/the-open-apologetic';

const isStoriesActive = currentPath.startsWith('/stories');

const navLinks = [
  { href: baseUrl + '/', label: 'Home' },
  { href: baseUrl + '/evidence', label: 'Evidence' },
  { href: baseUrl + '/stories', label: 'Stories', hasDropdown: true },
];

const storiesSubNav = [
  { href: baseUrl + '/stories/testimonies', label: 'Testimonies' },
  { href: baseUrl + '/stories/miracles', label: 'Miracles' },
];

const isActive = (href: string) => {
  const path = href.replace(baseUrl, '');
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---

<header class={styles.header}>
  <div class={styles.headerInner}>
    <a href={baseUrl + '/'} class={styles.logo}>
      <span class={styles.logoIcon}>✝</span>
      <span>The Open Apologetic</span>
    </a>
    
    <nav class={styles.nav}>
      {navLinks.map((link) => (
        link.hasDropdown ? (
          <div class={styles.dropdown}>
            <a 
              href={link.href} 
              class:list={[
                styles.navLink, 
                { 
                  active: currentPath === link.href || isStoriesActive 
                }
              ]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {link.label}
              <span class={styles.dropdownArrow}>▼</span>
            </a>
            <div class={styles.dropdownMenu}>
              {storiesSubNav.map((subLink) => (
                <a 
                  href={subLink.href} 
                  class:list={[
                    styles.dropdownLink,
                    { active: currentPath === subLink.href }
                  ]}
                >
                  {subLink.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a 
            href={link.href} 
            class:list={[styles.navLink, { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        )
      ))}
      <a 
        href={siteConfig.github} 
        class={styles.navLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View on GitHub"
      >
        <Icon name="github" size={18} />
      </a>
    </nav>
  </div>
</header>
