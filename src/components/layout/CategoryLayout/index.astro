---
import CategoryFilter from '../CategoryFilter/index.astro';
import styles from './styles.module.css';

interface Category {
  id: string;
  label: string;
}

interface Props {
  categories: Category[];
  activeCategory?: string;
  currentPath: string;
  title: string;
  description: string;
  baseUrl: string;
  section: 'evidence' | 'stories';
}

const { categories, activeCategory, currentPath, title, description, baseUrl, section } = Astro.props;
---

<div class={styles.layout}>
  <CategoryFilter 
    {categories}
    {activeCategory}
    {currentPath}
    {baseUrl}
    {section}
  />
  
  <main class={styles.main}>
    <div class={styles.pageInner}>
      <div class={styles.header}>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      
      <slot />
    </div>
  </main>
</div>
