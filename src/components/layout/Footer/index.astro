---
import styles from './styles.module.css';
import Icon from '../../foundation/Icon/index.astro';
import { siteConfig } from '../../../config/site';

const baseUrl = '/the-open-apologetic';
---

<footer class={styles.footer}>
  <div class={styles.footerInner}>
    <div class={styles.footerContent}>
      <div class={styles.footerSection}>
        <h3>Open Source</h3>
        <p>
          This project is open source under the GPLv3 License. Contributions are welcome!
        </p>
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class={styles.githubLink}>
          <Icon name="github" size={20} />
          Contribute
        </a>
      </div>
      
      <div class={styles.footerSection}>
        <h3>Quick Links</h3>
        <ul>
          <li><a href={baseUrl + '/'}>Home</a></li>
          <li><a href={baseUrl + '/evidence'}>Evidence</a></li>
          <li><a href={baseUrl + '/stories'}>Stories</a></li>
          <li><a href={baseUrl + '/stories/testimonies'}>Testimonies</a></li>
          <li><a href={baseUrl + '/stories/miracles'}>Miracles</a></li>
          <li><a href={siteConfig.github + '/blob/main/CONTRIBUTING.md'} target="_blank" rel="noopener noreferrer">Contribution Guide</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
