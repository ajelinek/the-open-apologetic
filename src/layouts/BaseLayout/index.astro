---
import Header from '../../components/layout/Header/index.astro';
import Footer from '../../components/layout/Footer/index.astro';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { 
  title, 
  description = 'Evidence for Catholic Christianity - Building a cumulative case through science, history, and faith.',
  currentPath = '/' 
} = Astro.props;

const fullTitle = title === 'Home' ? 'The Open Apologetic' : `${title} | The Open Apologetic`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <div class="layout">
      <Header currentPath={currentPath} />
      
      <main id="main-content" class="main">
        <slot />
      </main>
      
      <Footer />
    </div>
  </body>
</html>
